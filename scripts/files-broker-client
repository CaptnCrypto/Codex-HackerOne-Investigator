#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import socket
import stat
import sys
import tempfile
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description="Submit one stdin JSON envelope to the private broker socket")
    parser.add_argument("socket", type=Path)
    parser.add_argument("output", type=Path)
    args = parser.parse_args()
    raw = sys.stdin.buffer.read(2 * 1024 * 1024 + 1)
    if len(raw) > 2 * 1024 * 1024:
        print("files-broker-client: input exceeds limit", file=sys.stderr); return 2
    try:
        json.loads(raw)
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.connect(str(args.socket)); client.sendall(raw.rstrip(b"\n") + b"\n")
            response = b""
            while not response.endswith(b"\n") and len(response) <= 6 * 1024 * 1024:
                chunk = client.recv(65536)
                if not chunk: break
                response += chunk
        json.loads(response)
        args.output.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if args.output.parent.is_symlink() or stat.S_IMODE(args.output.parent.stat().st_mode) & 0o077:
            raise ValueError("output directory is not private")
        descriptor, temporary = tempfile.mkstemp(prefix=".broker-response-", dir=args.output.parent)
        os.fchmod(descriptor, 0o600); os.write(descriptor, response); os.fsync(descriptor); os.close(descriptor)
        os.replace(temporary, args.output)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"files-broker-client: {type(exc).__name__}", file=sys.stderr); return 2
    print("broker response saved privately")
    return 0


if __name__ == "__main__": raise SystemExit(main())
